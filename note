#!/usr/bin/env bash
#
# note - notational-velocity switcher over a flat folder of markdown notes
#
# Standalone script; symlink into $PATH. Notes are the markdown files directly
# in $NOTE_HOME — no subfolders, no notebooks. Structure comes from '#tags'
# inside the notes (e.g. #moc), which the switcher shows and searches.
#
#   note [-c] [<query>]   filter notes, open the pick in $EDITOR or create one

# Editor for opening/creating notes; honors $EDITOR (may include flags, e.g.
# "code -w"; split on whitespace), defaults to vim.
read -ra EDITOR_CMD <<< "${EDITOR:-vim}"
[ ${#EDITOR_CMD[@]} -gt 0 ] || EDITOR_CMD=(vim)  # whitespace-only $EDITOR
readonly EDITOR_CMD

# Print a message to stderr and exit non-zero.
die() { echo "$*" >&2; exit 1; }

# Filter selecting note files: *.md only (the suffix the switcher hides and
# adds on create), top level only (flat), excluding _-prefixed. Shared by the
# file listing and the tag scan so both see exactly the same set of notes.
readonly NOTE_FILTER=(--max-depth 1 --glob '*.md' --glob '!_*')

# List note files in a folder, sorted so the switcher order is stable.
list_notes() { rg --files --sort path "${NOTE_FILTER[@]}" "$1"; }

# True when a new note's file name would be listed by NOTE_FILTER (top level,
# not _-prefixed) and not hidden. rg's ignore files (.gitignore etc.) can still
# hide a note; that is left to the user.
is_listable_name() { [[ "$1" != */* && "$1" != [_.]* ]]; }

# A '#word' tag: preceded by start-of-line or whitespace so markdown headings
# ('# Title') and URL fragments ('foo#bar') never match.
readonly TAG_RE='(^|[[:space:]])#[A-Za-z][A-Za-z0-9_/-]*'
# Byte rg puts between a matched file's path and the tag, and that awk splits
# on. US (0x1F) can never appear in a path or tag, so the split is always safe.
readonly TAG_FIELD_SEP=$'\x1f'
# Dim cyan so tags read as secondary next to the note name (needs fzf --ansi).
readonly TAG_COLOR=$'\033[2;36m' TAG_RESET=$'\033[0m'
# Cap the note-name column so one long name can't push every tag off-screen.
readonly MAX_NAME_WIDTH=50

# List notes in a folder as two tab-separated columns for the switcher:
#   <padded name + colored #tags>\t<file path>
# fzf (with --ansi) shows and searches field 1; note_switch strips the
# selection back to field 2. A single rg pass collects every tag with its file;
# awk aggregates them per note (deduped, in document order) and left-joins the
# full note list so tag-less notes still appear. Doing this in awk — rather
# than a shell loop that spawns rg per file — keeps the switcher fast on large
# folders. The name column is padded to the widest name (capped) so tags line
# up.
notes_with_tags() {
    local root="$1"
    awk -F"$TAG_FIELD_SEP" -v col="$TAG_COLOR" -v rst="$TAG_RESET" \
        -v cap="$MAX_NAME_WIDTH" '
        # First input (note list): record each note in order, track widest name.
        FNR == NR {
            name = $0; sub(/.*\//, "", name); sub(/\.md$/, "", name)
            order[++n] = $0; nameof[$0] = name
            if (length(name) > width) width = length(name)
            next
        }
        # Second input (rg "path<US>#tag" matches): collect deduped tags per note.
        {
            file = $1; tag = $2; gsub(/[ \t]/, "", tag)
            if (!((file SUBSEP tag) in seen)) {
                seen[file SUBSEP tag] = 1
                tags[file] = tags[file] (tags[file] ? " " : "") tag
            }
        }
        END {
            if (width > cap) width = cap
            for (k = 1; k <= n; k++) {
                file = order[k]
                suffix = (tags[file] != "") ? "  " col tags[file] rst : ""
                printf "%-*s%s\t%s\n", width, nameof[file], suffix, file
            }
        }
    ' <(list_notes "$root") \
      <(rg -o -N --no-heading --color=never --field-match-separator "$TAG_FIELD_SEP" \
            "$TAG_RE" "${NOTE_FILTER[@]}" "$root")
}

show_help() {
    cat <<'EOF'
note - notational-velocity switcher over a flat folder of markdown notes

USAGE
    note [-c] [<query>]      filter notes, open the pick or create the typed
                               name; .md is implicit (never typed, never shown)
    note help                show this message

KEYS
    enter                    open the highlighted match (with -c, also create
                               the typed name when nothing matches)
    ctrl-n                   create a note named by your query (default mode
                               only; near-matches stay visible, so a typo never
                               silently forks the namespace)

FLAGS
    -c, --create-on-enter    make enter create on no match and drop ctrl-n, so
                               a single key both opens and creates (fast
                               capture). An over-filtered (empty) list creates
                               your raw query, so use it knowingly.

TAGS
    '#word' tags in a note are listed next to its name and searchable: type
    #moc to filter to notes tagged #moc.

ENVIRONMENT
    NOTE_HOME       notes folder, flat (default: ~/notes)
    EDITOR          editor for notes (default: vim)
EOF
}

# note [-c] [<query>] — notational-velocity switcher: open a note, or create
# the typed name. The two modes have exactly one create key each, never both:
# default binds ctrl-n via --expect; -c omits --expect so enter on no match
# (fzf exit 1) is the only create path. Esc (130) never creates, so an aborted
# picker cannot fork the namespace by accident.
note_switch() {
    local query="" create_on_enter=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -c|--create-on-enter)
                create_on_enter=1; shift ;;
            -*) die "unknown flag: $1" ;;
            *)
                [ -z "$query" ] || die "unexpected arg: $1"
                query="$1"; shift ;;
        esac
    done

    # Show/search only the display field and interpret its color codes.
    local args=(-e --height '~40%' --layout=reverse --print-query
                --ansi --delimiter=$'\t' --with-nth=1 --nth=1)
    if [ "$create_on_enter" = 1 ]; then
        args+=(--header 'enter: open/create')
    else
        args+=(--expect=ctrl-n --header 'enter: open   ctrl-n: create typed name')
    fi
    [ -n "$query" ] && args+=(-q "$query")

    local out rc typed key="" selected
    out=$(notes_with_tags "$home" | fzf "${args[@]}"); rc=$?
    # fzf prints the query first (--print-query), then a key line only when
    # --expect is set, then the "<display>\t<path>" selection.
    if [ "$create_on_enter" = 1 ]; then
        { IFS= read -r typed; IFS= read -r selected; } <<< "$out"
    else
        { IFS= read -r typed; IFS= read -r key; IFS= read -r selected; } <<< "$out"
    fi
    selected="${selected#*$'\t'}"

    if [ "$key" = ctrl-n ] || { [ "$create_on_enter" = 1 ] && [ "$rc" = 1 ]; }; then
        [ -n "$typed" ] || exit 0
        local base="${typed%.md}.md" existing
        is_listable_name "$base" || die "not a listable note name (no '/', no leading '_' or '.'): $base"
        # Reuse an existing note whose name differs only in case, so a
        # capitalisation slip never forks the namespace.
        existing=$(list_notes "$home" | grep -iFxm1 -- "$home/$base")
        "${EDITOR_CMD[@]}" "${existing:-$home/$base}"
    elif [ "$rc" = 0 ] && [ -n "$selected" ]; then
        "${EDITOR_CMD[@]}" "$selected"
    fi
}

main() {
    home="${NOTE_HOME:-$HOME/notes}"
    home="${home%/}"  # match rg's paths, which never carry a doubled slash

    case "$1" in
        -h|--help|help)
            show_help ;;
        *)
            [ -d "$home" ] || die "notes folder not found: $home (set NOTE_HOME)"
            note_switch "$@" ;;  # bare default, incl. no args
    esac
}

main "$@"
